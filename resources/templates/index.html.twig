{% extends 'components/base.html.twig' %}

{% block title %}{{ site.title }}{% endblock %}

{% block content %}
    <h2>Latest Posts</h2>
    {% for item in items %}
        <article>
            <h3><a href="/post/{{ item.slug }}">{{ item.title }}</a></h3>
            <p><small>Posted on {{ item.publishDate|format_datetime('medium','none') }}</small></p>
            <p>{{ item.synopsis }}</p>
        </article>
    {% else %}
        <p>No posts found.</p>
    {% endfor %}
{% endblock %}